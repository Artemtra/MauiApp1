<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.NewPage1"
             Title="NewPage1">
    <VerticalStackLayout>
        <Label Text="Имя" />
        <Entry  x:Name="Name"/>
        <Label Text="Фамилия"/>
        <Entry x:Name="SecondName" />
        <Label Text="Отчество"/>
        <Entry x:Name="ThirtyName" />
        <Label Text="День рождения"/>
        <DatePicker  x:Name="BirthdayDate" />
        <Button  Text="Сохранить" x:Name="SaveAuthorButton" Clicked="Button_Clicked_Author"/>
    </VerticalStackLayout>
</ContentPage>