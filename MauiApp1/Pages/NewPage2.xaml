<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Pages.NewPage2"
             Title="NewPage2">
    <VerticalStackLayout>
        <Label 
            Text="Список фильмов"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Button  Text="Home"  Clicked="Button_Clicked"/>
        <ListView ItemsSource="{Binding AuthorList}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <ViewCell.View>
                            <StackLayout Orientation="Horizontal">

                                <Label Text="{Binding Name}"  Margin="10,0,5,5"/>
                                <Label Text="{Binding SecondName}"  Margin="10,0,5,5" />
                                <Label Text="{Binding ThrityName}" Margin="10,0,5,5" />
                                <Label Text="{Binding BirthDay}" Margin="10,0,5,5"/>
                            </StackLayout>
                        </ViewCell.View>
                    </ViewCell>

                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </VerticalStackLayout>
</ContentPage>